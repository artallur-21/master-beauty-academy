---
import '@styles/global.css';
import SEO from '@components/SEO.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import WhatsAppFloat from '@components/WhatsAppFloat.astro';
import StickyMobileCTA from '@components/StickyMobileCTA.astro';
import UrgencyBanner from '@components/UrgencyBanner.astro';
import ExitIntentPopup from '@components/ExitIntentPopup.astro';
import type { SeoProps } from '@lib/seo';

interface Props extends SeoProps {
  schema?: Record<string, unknown>[] | Record<string, unknown>;
  preloadImage?: string;
  hideStickyCta?: boolean;
  hideUrgencyBanner?: boolean;
  hideExitIntent?: boolean;
}
const { schema, preloadImage, hideStickyCta = false, hideUrgencyBanner = false, hideExitIntent = false, ...seo } = Astro.props;
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta http-equiv="x-ua-compatible" content="IE=edge" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title="Master Beauty Academy Blog" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <SEO {...seo} schema={schema} preloadImage={preloadImage} />
  </head>
  <body class="bg-cream text-ink-900 pb-16 lg:pb-0">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-white focus:text-brand-700 focus:px-3 focus:py-2 focus:rounded">Skip to main content</a>
    {!hideUrgencyBanner && <UrgencyBanner />}
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
    {!hideStickyCta && <StickyMobileCTA />}
    {!hideExitIntent && <ExitIntentPopup />}

    {/* Open all CTAs / external links in a new tab (per review-sheet directive).
        Excludes: in-page #anchor links, links with explicit target=_self, and
        the skip-to-content link so accessibility is preserved. */}
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const here = location.host;
        document.querySelectorAll('a[href]').forEach((a) => {
          const href = a.getAttribute('href') || '';
          if (!href) return;
          if (href.startsWith('#')) return;
          if (a.target === '_self') return;
          if (a.hasAttribute('data-keep-self')) return;
          // Skip links inside the skip-to-content nav
          if (a.classList.contains('sr-only') || a.closest('.sr-only')) return;
          if (!a.target) a.target = '_blank';
          const rel = (a.getAttribute('rel') || '').split(/\s+/).filter(Boolean);
          if (!rel.includes('noopener')) rel.push('noopener');
          a.setAttribute('rel', rel.join(' '));
        });
      });
    </script>
  </body>
</html>
