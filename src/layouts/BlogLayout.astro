---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import FAQ from '@components/FAQ.astro';
import CTA from '@components/CTA.astro';
import { articleSchema, breadcrumbSchema, faqSchema } from '@lib/schema';
import { SITE } from '@lib/site';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  keyword: string;
  slug: string;
  tags?: string[];
  readingTime?: string;
  faqs?: { q: string; a: string }[];
}
const { title, description, pubDate, updatedDate, author, keyword, slug, tags = [], readingTime, faqs = [] } = Astro.props;

const fmt = (d: Date) => d.toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' });
const ogImage = `/images/og-default.jpg`;

const schema = [
  articleSchema({
    title,
    description,
    slug,
    image: ogImage,
    datePublished: pubDate.toISOString(),
    dateModified: updatedDate?.toISOString(),
    author,
  }),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/blog' },
    { name: title, url: `/blog/${slug}` },
  ]),
  ...(faqs.length ? [faqSchema(faqs)] : []),
];
---

<BaseLayout
  title={title}
  description={description}
  path={`/blog/${slug}`}
  type="article"
  keywords={[keyword, ...tags]}
  schema={schema}
>
  <Breadcrumbs items={[{ name: 'Home', url: '/' }, { name: 'Blog', url: '/blog' }, { name: title, url: `/blog/${slug}` }]} />

  <article class="container-w container-px py-10 lg:py-16">
    <header class="max-w-3xl">
      <p class="eyebrow">Beauty Industry Insights</p>
      <h1 class="mt-4 text-balance">{title}</h1>
      <p class="mt-5 text-lg text-ink-500 text-pretty">{description}</p>
      <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-ink-500">
        <span>{author}</span>
        <span aria-hidden="true">·</span>
        <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
        {readingTime && <><span aria-hidden="true">·</span><span>{readingTime}</span></>}
      </div>
    </header>

    <div class="mt-12 grid lg:grid-cols-[1fr_280px] gap-12">
      <div class="prose-luxe max-w-2xl">
        <slot />
      </div>
      <aside class="lg:sticky lg:top-28 self-start">
        <div class="card !bg-brand-50 !border-brand-100">
          <p class="eyebrow">Next batch</p>
          <h3 class="mt-3 font-serif text-xl">Speak to a counsellor today.</h3>
          <p class="mt-2 text-ink-700 text-sm">Get fee details, batch timings and a personalised plan.</p>
          <a href="/contact" class="btn btn-primary !py-2.5 !px-5 text-sm mt-5">Get Counselling</a>
        </div>
      </aside>
    </div>
  </article>

  {faqs.length > 0 && <FAQ items={faqs} heading="Questions readers ask" eyebrow="FAQ" />}
  <CTA />
</BaseLayout>
