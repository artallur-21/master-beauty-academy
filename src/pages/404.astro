---
import BaseLayout from '@layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist. Browse our beautician course pages or contact us." path="/404" noindex>
  <section class="container-w container-px py-24 lg:py-32 text-center">
    <p class="eyebrow justify-center">404</p>
    <h1 class="mt-4">We couldn't find that page.</h1>
    <p class="mt-5 max-w-xl mx-auto text-ink-500 text-pretty">The link may be broken or the page may have moved. Here are some useful next steps.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-primary">Back to Home</a>
      <a href="/beautician-course" class="btn btn-outline">Beautician Course</a>
      <a href="/contact" class="btn btn-outline">Contact Us</a>
    </div>
  </section>
</BaseLayout>
