---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { breadcrumbSchema } from '@lib/schema';
import BlogCard from '@components/BlogCard.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const schema = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog' },
]);
---

<BaseLayout
  title="Beautician Career & Beauty Industry Insights — Master Makeup Studio & Academy Blog"
  description="Career guides, fee comparisons, technique deep-dives and beauty industry insights from Master Makeup Studio & Academy. Practical reading for aspiring and working beauticians."
  path="/blog"
  schema={schema}
>
  <Breadcrumbs items={[{ name: 'Home', url: '/' }, { name: 'Blog', url: '/blog' }]} />

  <section class="container-w container-px pt-8 pb-12">
    <p class="eyebrow">The Journal</p>
    <h1 class="mt-4 max-w-3xl text-balance">Beautician career & beauty industry insights.</h1>
    <p class="mt-5 max-w-2xl text-lg text-ink-500 text-pretty">Career guides, fee comparisons and technique deep-dives — written for aspiring and working beauticians.</p>
  </section>

  <section class="container-w container-px pb-20">
    <ul class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((p, i) => (
        <li>
          <BlogCard
            href={`/blog/${p.slug}`}
            title={p.data.title}
            description={p.data.description}
            pubDate={p.data.pubDate}
            readingTime={p.data.readingTime ?? '6 min read'}
            tag={p.data.tags?.[0]}
            index={i}
          />
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
