---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import EnquiryForm from '@components/EnquiryForm.astro';
import LocationCards from '@components/LocationCards.astro';
import { SITE } from '@lib/site';
import { breadcrumbSchema, localBusinessSchema } from '@lib/schema';

const schema = [
  breadcrumbSchema([{ name: 'Home', url: '/' }, { name: 'Contact', url: '/contact' }]),
  localBusinessSchema('belagavi'),
  localBusinessSchema('hubballi'),
];
---

<BaseLayout
  title="Contact Master Makeup Studio & Academy — Enquire About Beautician Course"
  description="Speak to Master Makeup Studio & Academy in Belagavi or Hubballi. Call, WhatsApp or fill the enquiry form for a free counselling call about fees, batches and certification."
  path="/contact"
  schema={schema}
>
  <Breadcrumbs items={[{ name: 'Home', url: '/' }, { name: 'Contact', url: '/contact' }]} />

  <section class="container-w container-px pt-8 pb-12 grid lg:grid-cols-2 gap-12">
    <div>
      <p class="eyebrow">Get in touch</p>
      <h1 class="mt-4 text-balance">Speak to our beautician counsellor today.</h1>
      <p class="mt-5 max-w-md text-lg text-ink-500 text-pretty">Fees, batch timings, EMI options or career advice — get a personalised counselling call within 24 hours.</p>

      <ul class="mt-8 space-y-4 text-ink-700">
        <li class="flex items-center gap-4">
          <span class="w-10 h-10 grid place-items-center rounded-full bg-brand-50 text-brand-700">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.86 19.86 0 0 1 2.08 4.18 2 2 0 0 1 4.07 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.72 2.8a2 2 0 0 1-.45 2.11L8 9.91a16 16 0 0 0 6.09 6.09l1.28-1.28a2 2 0 0 1 2.11-.45c.9.36 1.84.59 2.8.72a2 2 0 0 1 1.72 2.03Z"/></svg>
          </span>
          <a href={`tel:${SITE.phonePrimary}`} class="font-medium hover:text-brand-700">{SITE.phonePrimary}</a>
        </li>
        <li class="flex items-center gap-4">
          <span class="w-10 h-10 grid place-items-center rounded-full bg-brand-50 text-brand-700">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 3.48A11.78 11.78 0 0 0 12.04 0C5.46 0 .1 5.36.1 11.94c0 2.1.55 4.16 1.6 5.98L0 24l6.24-1.63a11.93 11.93 0 0 0 5.8 1.48c6.58 0 11.94-5.36 11.94-11.94 0-3.19-1.24-6.19-3.47-8.43Z"/></svg>
          </span>
          <a href={`https://wa.me/${SITE.phoneWhatsapp}`} rel="noopener" class="font-medium hover:text-brand-700">WhatsApp us</a>
        </li>
        <li class="flex items-center gap-4">
          <span class="w-10 h-10 grid place-items-center rounded-full bg-brand-50 text-brand-700">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="m22 6-10 7L2 6"/></svg>
          </span>
          <a href={`mailto:${SITE.email}`} class="font-medium hover:text-brand-700">{SITE.email}</a>
        </li>
      </ul>
    </div>

    <div>
      <EnquiryForm id="contact-enquiry" compact />
    </div>
  </section>

  <section id="brochure" class="container-w container-px py-12 scroll-mt-24">
    <div class="grad-hero text-white rounded-2xl p-8 md:p-12 grid lg:grid-cols-[1.4fr_1fr] gap-8 items-start">
      <div>
        <p class="eyebrow !text-gold-400 [&::before]:bg-gold-400">Download brochure</p>
        <h2 class="mt-3 text-white text-balance">Get the complete course brochure on WhatsApp.</h2>
        <p class="mt-3 text-ink-200 max-w-xl text-pretty">Includes the 15-module syllabus, fee structure, EMI options, sample certificate, batch schedule and placement details — delivered instantly on WhatsApp.</p>
        <ul class="mt-5 grid sm:grid-cols-2 gap-2 text-sm text-ink-200">
          <li class="flex gap-2"><span class="text-gold-400 mt-1">✦</span> 15-module syllabus</li>
          <li class="flex gap-2"><span class="text-gold-400 mt-1">✦</span> Transparent fee breakdown</li>
          <li class="flex gap-2"><span class="text-gold-400 mt-1">✦</span> Sample certificate</li>
          <li class="flex gap-2"><span class="text-gold-400 mt-1">✦</span> Batch schedule + EMI plan</li>
        </ul>
      </div>
      <div class="bg-white text-ink-900 rounded-xl p-5">
        <EnquiryForm id="brochure-enquiry" />
      </div>
    </div>
  </section>

  <LocationCards />
</BaseLayout>
