---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import EnquiryForm from '@components/EnquiryForm.astro';
import LocationCards from '@components/LocationCards.astro';
import { SITE } from '@lib/site';
import { breadcrumbSchema, localBusinessSchema } from '@lib/schema';

const schema = [
  breadcrumbSchema([{ name: 'Home', url: '/' }, { name: 'Contact', url: '/contact' }]),
  localBusinessSchema('belagavi'),
  localBusinessSchema('hubballi'),
];
---

<BaseLayout
  title="Contact Master Beauty Academy — Enquire About Beautician Course"
  description="Speak to Master Beauty Academy in Hubli or Belagavi. Call, WhatsApp or fill the enquiry form for a free counselling call about fees, batches and certification."
  path="/contact"
  schema={schema}
>
  <Breadcrumbs items={[{ name: 'Home', url: '/' }, { name: 'Contact', url: '/contact' }]} />

  {/* Hero — centred per review */}
  <section class="container-w container-px pt-8 pb-10 text-center">
    <p class="eyebrow justify-center">Get in touch</p>
    <h1 class="mt-4 mx-auto max-w-2xl text-balance">Speak to our beautician counsellor today.</h1>
    <p class="mt-5 mx-auto max-w-2xl text-base lg:text-lg text-ink-500 text-pretty">Fees, batch timings, EMI options or career advice — get a personalised counselling call within 24 hours.</p>

    <ul class="mt-8 inline-flex flex-wrap items-center justify-center gap-3 text-sm">
      <li class="inline-flex items-center gap-2 bg-brand-50 text-brand-700 border border-brand-100 px-3 py-2 rounded-full">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.86 19.86 0 0 1 2.08 4.18 2 2 0 0 1 4.07 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.72 2.8a2 2 0 0 1-.45 2.11L8 9.91a16 16 0 0 0 6.09 6.09l1.28-1.28a2 2 0 0 1 2.11-.45c.9.36 1.84.59 2.8.72a2 2 0 0 1 1.72 2.03Z"/></svg>
        <a href={`tel:${SITE.phonePrimary}`} class="font-medium">{SITE.phonePrimary}</a>
      </li>
      <li class="inline-flex items-center gap-2 bg-brand-50 text-brand-700 border border-brand-100 px-3 py-2 rounded-full">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.52 3.48A11.78 11.78 0 0 0 12.04 0C5.46 0 .1 5.36.1 11.94c0 2.1.55 4.16 1.6 5.98L0 24l6.24-1.63a11.93 11.93 0 0 0 5.8 1.48c6.58 0 11.94-5.36 11.94-11.94 0-3.19-1.24-6.19-3.47-8.43Z"/></svg>
        <a href={`https://wa.me/${SITE.phoneWhatsapp}`} rel="noopener" class="font-medium">WhatsApp us</a>
      </li>
      <li class="inline-flex items-center gap-2 bg-brand-50 text-brand-700 border border-brand-100 px-3 py-2 rounded-full">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="m22 6-10 7L2 6"/></svg>
        <a href={`mailto:${SITE.email}`} class="font-medium">{SITE.email}</a>
      </li>
    </ul>
  </section>

  {/* Enquiry form — centred */}
  <section class="container-w container-px pb-12">
    <div class="max-w-xl mx-auto">
      <EnquiryForm id="contact-enquiry" />
    </div>
  </section>

  {/* Brochure section — form replaced with image per review-sheet R07 */}
  <section id="brochure" class="container-w container-px py-12 scroll-mt-24">
    <div class="grad-hero text-white rounded-2xl p-8 md:p-12 grid lg:grid-cols-[1.2fr_1fr] gap-8 lg:gap-12 items-center">
      <div>
        <p class="eyebrow !text-gold-400 [&::before]:bg-gold-400">Download brochure</p>
        <h2 class="mt-3 text-white text-balance">Get the complete course brochure on WhatsApp.</h2>
        <p class="mt-3 text-ink-200 max-w-xl text-pretty">The complete 9-category syllabus, fee structure, EMI options, sample certificate, batch schedule and placement details — delivered straight to your WhatsApp.</p>
        <ul class="mt-5 grid sm:grid-cols-2 gap-2 text-sm text-ink-200">
          <li class="flex gap-2"><span class="text-gold-400 mt-1">✦</span> 9-category syllabus</li>
          <li class="flex gap-2"><span class="text-gold-400 mt-1">✦</span> Transparent ₹40,000 fee breakdown</li>
          <li class="flex gap-2"><span class="text-gold-400 mt-1">✦</span> Sample certificate</li>
          <li class="flex gap-2"><span class="text-gold-400 mt-1">✦</span> Batch schedule + EMI plan</li>
        </ul>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={`https://wa.me/${SITE.phoneWhatsapp}?text=${encodeURIComponent('Hi, please send me the Master Beauty Academy course brochure.')}`} rel="noopener" class="btn btn-gold">Request brochure on WhatsApp</a>
          <a href={`tel:${SITE.phonePrimary}`} class="btn btn-outline !bg-transparent !text-white !border-white/30 hover:!border-white">Or call us</a>
        </div>
      </div>
      <figure class="relative max-w-[420px] mx-auto lg:max-w-[460px] lg:justify-self-end">
        <div aria-hidden="true" class="absolute -inset-6 rounded-3xl bg-gold-400/10 blur-3xl"></div>
        <img
          src="/images/cta-master-700.webp"
          srcset="/images/cta-master-700.webp 700w, /images/cta-master.webp 1200w"
          sizes="(min-width:1024px) 460px, (min-width:640px) 60vw, 90vw"
          alt="Master Beauty Academy — request brochure"
          width="800" height="1000"
          loading="lazy" decoding="async"
          class="relative w-full h-auto object-contain drop-shadow-[0_24px_70px_rgba(0,0,0,0.55)]"
        />
      </figure>
    </div>
  </section>

  <LocationCards />
</BaseLayout>
