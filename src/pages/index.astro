---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import TrustBar from '@components/TrustBar.astro';
import HomeAbout from '@components/HomeAbout.astro';
import WhyChoose from '@components/WhyChoose.astro';
import BbsProgram from '@components/BbsProgram.astro';
import CourseSnapshot from '@components/CourseSnapshot.astro';
import Gallery from '@components/Gallery.astro';
import Testimonials from '@components/Testimonials.astro';
import VideoTestimonials from '@components/VideoTestimonials.astro';
import LocationCards from '@components/LocationCards.astro';
import FAQ from '@components/FAQ.astro';
import BlogPreview from '@components/BlogPreview.astro';
import CTA from '@components/CTA.astro';
import { getEntry } from 'astro:content';
import { courseSchema, faqSchema, localBusinessSchema, reviewSchema } from '@lib/schema';

const homeFaqs = await getEntry('faqs', 'home');
const schema = [
  courseSchema(),
  localBusinessSchema('belagavi'),
  localBusinessSchema('hubballi'),
  faqSchema(homeFaqs.data.items),
  reviewSchema([
    { author: 'Priya Patil', rating: 5, text: 'Best beautician academy in Belagavi — incredible hands-on training.' },
    { author: 'Anjali Kulkarni', rating: 5, text: 'I opened my own parlour six months after graduating. Worth every rupee.' },
    { author: 'Shruti Desai', rating: 5, text: 'Senior trainers, small batches, real client practice.' },
  ]),
];
---

<BaseLayout
  title="Beautician Course in Belagavi | Beauty Parlour Course | Master Beauty Academy"
  description="Join the best Beautician Course in Belagavi at Master Beauty Academy. Learn Hydra Facial, Haircutting, Waxing, Hair Botox, Hair Smoothening and start your beauty career or beauty parlour business. Admissions Open."
  path="/"
  keywords={[
    'Beautician Course in Belagavi',
    'Beauty Parlour Course in Belagavi',
    'Beauty Academy in Belagavi',
    'Beauty Training Institute in Belagavi',
    'Beautician Classes in Belagavi',
    'Beauty Parlour Training in Belagavi',
    'Professional Beautician Course in Belagavi',
    'Beauty Therapist Course in Belagavi',
    'Best Beauty Academy in Belagavi',
    'Beauty Courses Near Me',
    'Bridal Makeup Course in Belagavi',
    'Hair Cutting Course in Belagavi',
    'Hydra Facial Training in Belagavi',
    'Hair Botox Training in Belagavi',
    'Hair Smoothening Course in Belagavi',
    'Beauty Parlour Business Course in Belagavi',
    'Beautician Training with Certificate in Belagavi',
    'Job Oriented Beautician Course in Belagavi',
    'Salon Management Course in Belagavi',
  ]}
  schema={schema}
  preloadImage="/images/master-herosection-800.webp"
>
  <Hero
    eyebrow="Beautician Course in Belagavi · Hubli"
    heading="The Best Beautician Course in Belagavi — Master Beauty Academy"
    sub="A 30-day Professional Beautician Course in Belagavi covering Hydra Facial, Haircutting, Waxing, Hair Botox, Hair Smoothening, Bridal Makeup and Salon Management — ₹40,000 all-inclusive. Beauty Parlour Course in Belagavi taught by award-winning founders Anilkumar Sakhe & Priyanka Sakhe (LAPT London · Global Fame Awards 2023). Admissions open."
  />
  <TrustBar />
  <HomeAbout />
  <WhyChoose />
  <BbsProgram />
  <CourseSnapshot />
  <Gallery />
  <VideoTestimonials />
  <Testimonials limit={3} />
  <LocationCards />
  <FAQ items={homeFaqs.data.items} heading="Everything aspiring beauticians ask" lead="Concise answers about the course, fees, timings, certification and career outcomes." />
  <BlogPreview />
  <CTA />
</BaseLayout>
