---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Gallery from '@components/Gallery.astro';
import CTA from '@components/CTA.astro';
import { breadcrumbSchema } from '@lib/schema';

const schema = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Gallery', url: '/gallery' },
]);
---

<BaseLayout
  title="Student Gallery — Master Beauty Academy"
  description="Inside our Belagavi & Hubli academies. Student practice, live-client sessions, certification days and graduation moments from Master Beauty Academy."
  path="/gallery"
  schema={schema}
>
  <Breadcrumbs items={[{ name: 'Home', url: '/' }, { name: 'Gallery', url: '/gallery' }]} />
  <section class="container-w container-px pt-8 pb-4 text-center">
    <p class="eyebrow justify-center">Inside the Academy</p>
    <h1 class="mt-4 mx-auto max-w-3xl text-balance">Real students. Real practice. Real results.</h1>
    <p class="mt-5 mx-auto max-w-2xl text-base lg:text-lg text-ink-500 text-pretty">A glimpse into our classrooms, live-client studio and graduation days across Hubli and Belagavi.</p>
  </section>
  <Gallery />
  <CTA />
</BaseLayout>
