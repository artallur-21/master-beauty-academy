---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import CTA from '@components/CTA.astro';
import { MODULES, SITE } from '@lib/site';
import { courseSchema, breadcrumbSchema } from '@lib/schema';

const schema = [
  courseSchema(),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Beautician Course', url: '/beautician-course' },
    { name: 'Curriculum', url: '/beautician-course/curriculum' },
  ]),
];
---

<BaseLayout
  title="Beautician Course Curriculum — 9-Category Professional Training"
  description="Complete 30-day beautician course curriculum at Master Beauty Academy: beauty & grooming, facial treatments, hand & foot care, wellness, hair care, hair cutting, salon management, makeup, advanced hair treatments."
  path="/beautician-course/curriculum"
  keywords={['beautician course syllabus', 'beautician training modules', 'beauty course curriculum']}
  schema={schema}
>
  <Breadcrumbs items={[
    { name: 'Home', url: '/' },
    { name: 'Beautician Course', url: '/beautician-course' },
    { name: 'Curriculum', url: '/beautician-course/curriculum' },
  ]} />

  <section class="container-w container-px pt-8 pb-8 lg:pt-10 lg:pb-10">
    <div class="grid lg:grid-cols-[1.05fr_1fr] gap-10 lg:gap-14 items-center">
      <div>
        <p class="eyebrow">Detailed curriculum</p>
        <h1 class="mt-4 text-balance">Beautician Course Curriculum — 9 Professional Categories</h1>
        <p class="mt-5 max-w-xl text-base lg:text-lg text-ink-500 text-pretty">
          A complete, category-by-category breakdown of what you learn in the 30-day Professional Beautician Course — beauty, skincare, hair care, wellness, salon management and professional makeup.
        </p>
        <ul class="mt-6 flex flex-wrap gap-3 text-sm">
          <li class="px-3 py-1.5 rounded-full bg-brand-50 text-brand-700 border border-brand-100 font-medium">{SITE.courseDurationDays} days</li>
          <li class="px-3 py-1.5 rounded-full bg-brand-50 text-brand-700 border border-brand-100 font-medium">₹{SITE.courseFee.toLocaleString('en-IN')}</li>
          <li class="px-3 py-1.5 rounded-full bg-brand-50 text-brand-700 border border-brand-100 font-medium">All-inclusive</li>
        </ul>
      </div>
      <figure class="relative max-w-[480px] mx-auto lg:max-w-[520px] lg:justify-self-end">
        <div aria-hidden="true" class="absolute -inset-5 rounded-3xl bg-gold-400/10 blur-2xl"></div>
        <img
          src="/images/curriculum-hero-800.webp"
          srcset="/images/curriculum-hero-800.webp 800w, /images/curriculum-hero.webp 1200w"
          sizes="(min-width:1024px) 520px, (min-width:640px) 60vw, 92vw"
          alt="Master Beauty Academy curriculum"
          width="800" height="1000"
          fetchpriority="high" decoding="async"
          class="relative w-full h-auto object-contain drop-shadow-[0_20px_60px_rgba(0,0,0,0.25)]"
        />
      </figure>
    </div>
  </section>

  <section class="container-w container-px pb-20">
    <ol class="grid gap-6">
      {MODULES.map((m) => (
        <li class="card !p-7 md:!p-9 grid md:grid-cols-[180px_1fr] gap-6 md:gap-10 items-start">
          <div>
            <span class="font-serif text-gold-500 text-sm tracking-widest">CATEGORY {String(m.n).padStart(2, '0')}</span>
            <h2 class="mt-2 font-serif text-2xl leading-tight">{m.title}</h2>
          </div>
          <div>
            <p class="text-ink-700 text-pretty">{m.desc}</p>
            {m.items && m.items.length > 0 && (
              <ul class="mt-4 grid sm:grid-cols-2 gap-x-6 gap-y-1.5">
                {m.items.map((d) => (
                  <li class="flex gap-2 text-sm text-ink-700"><span class="text-brand-700 mt-1.5">●</span>{d}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <CTA heading="Enrol in the 30-day Professional Beautician Course." />
</BaseLayout>
