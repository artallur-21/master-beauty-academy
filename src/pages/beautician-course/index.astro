---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import FAQ from '@components/FAQ.astro';
import EnquiryForm from '@components/EnquiryForm.astro';
import CTA from '@components/CTA.astro';
import { MODULES } from '@lib/site';
import { courseSchema, faqSchema, breadcrumbSchema } from '@lib/schema';
import { getEntry } from 'astro:content';
import DayInLife from '@components/DayInLife.astro';
import FeeTable from '@components/FeeTable.astro';
import CertificatePreview from '@components/CertificatePreview.astro';
import RelatedPages from '@components/RelatedPages.astro';

const courseFaqs = await getEntry('faqs', 'course');
const schema = [
  courseSchema(),
  faqSchema(courseFaqs.data.items),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Beautician Course', url: '/beautician-course' },
  ]),
];
---

<BaseLayout
  title="Professional Beautician Course — 30 Days · ₹40,000 · Hubli & Belagavi"
  description="Master Beauty Academy's 30-day Professional Beautician Course covers beauty, grooming, skincare, hair care, wellness, salon management and professional makeup. ₹40,000 all-inclusive. Founded by award-winning makeup artist Priyanka Sakhe."
  path="/beautician-course"
  keywords={['professional beautician course', 'beauty parlour course', 'beautician course fees', 'hubli belagavi beauty academy']}
  schema={schema}
>
  <Breadcrumbs items={[{ name: 'Home', url: '/' }, { name: 'Beautician Course', url: '/beautician-course' }]} />

  <section class="container-w container-px pt-8 pb-10 grid lg:grid-cols-[1.4fr_1fr] gap-12 items-start">
    <div>
      <p class="eyebrow">Flagship Programme</p>
      <h1 class="mt-4 text-balance">Professional Beautician Course — Beauty, Skincare, Hair, Wellness & Makeup</h1>
      <p class="mt-6 max-w-2xl text-lg text-ink-500 text-pretty">A 30-day hands-on certification covering 9 professional categories — threading & waxing, advanced facials & HydraFacial, hand & foot care, wellness & massage, hair care & cutting, salon management, makeup training, and advanced hair treatments. Designed to transform passion into a profession.</p>

      <ul class="mt-8 grid sm:grid-cols-3 gap-4">
        <li class="card !p-5">
          <p class="text-xs uppercase tracking-widest text-gold-500">Duration</p>
          <p class="font-serif text-xl mt-1">30 Days</p>
          <p class="text-sm text-ink-500 mt-1">Intensive hands-on training</p>
        </li>
        <li class="card !p-5">
          <p class="text-xs uppercase tracking-widest text-gold-500">Course Fee</p>
          <p class="font-serif text-xl mt-1">₹40,000</p>
          <p class="text-sm text-ink-500 mt-1">All-inclusive · no hidden cost</p>
        </li>
        <li class="card !p-5">
          <p class="text-xs uppercase tracking-widest text-gold-500">Certification</p>
          <p class="font-serif text-xl mt-1">Recognised</p>
          <p class="text-sm text-ink-500 mt-1">Founder-signed certificate</p>
        </li>
      </ul>
    </div>
    <div id="enquire" class="lg:sticky lg:top-28">
      <EnquiryForm id="course-enquiry" />
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-w container-px">
      <p class="eyebrow">What you'll learn</p>
      <h2 class="mt-3 max-w-2xl text-balance">9 categories. Every essential beauty-professional skill.</h2>
      <ol class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {MODULES.map((m) => (
          <li class="card">
            <span class="font-serif text-gold-500 text-sm tracking-widest">CATEGORY {String(m.n).padStart(2, '0')}</span>
            <h3 class="mt-2 font-serif text-lg">{m.title}</h3>
            <p class="mt-2 text-ink-500 text-sm">{m.desc}</p>
          </li>
        ))}
      </ol>
      <div class="mt-12">
        <a href="/beautician-course/curriculum" class="btn btn-outline">View detailed curriculum →</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-w container-px grid lg:grid-cols-2 gap-12">
      <div>
        <p class="eyebrow">Training methodology</p>
        <h2 class="mt-3 text-balance">70% practical. 30% theory. 100% supervised.</h2>
        <p class="mt-4 text-ink-500 text-pretty">Every module pairs short theoretical sessions with extensive hands-on practice on mannequins, peers and live clients. You leave each module with both knowledge and muscle memory.</p>
        <ul class="mt-6 space-y-3 text-ink-700">
          <li class="flex gap-3"><span class="text-brand-700">✦</span> Live-client practice from week 3 onwards</li>
          <li class="flex gap-3"><span class="text-brand-700">✦</span> Complete beautician starter kit included</li>
          <li class="flex gap-3"><span class="text-brand-700">✦</span> Written + practical final assessment</li>
          <li class="flex gap-3"><span class="text-brand-700">✦</span> Salon-readiness coaching in the final week</li>
        </ul>
      </div>
      <div>
        <p class="eyebrow">Who should join</p>
        <h2 class="mt-3 text-balance">Built for serious learners — at any stage.</h2>
        <ul class="mt-6 space-y-3 text-ink-700">
          <li class="flex gap-3"><span class="text-brand-700">✦</span> School graduates planning a beauty career</li>
          <li class="flex gap-3"><span class="text-brand-700">✦</span> Homemakers re-entering the workforce</li>
          <li class="flex gap-3"><span class="text-brand-700">✦</span> Working salon staff seeking formal certification</li>
          <li class="flex gap-3"><span class="text-brand-700">✦</span> Aspiring entrepreneurs planning to open a parlour</li>
        </ul>
      </div>
    </div>
  </section>

  <DayInLife />
  <FeeTable />
  <CertificatePreview />
  <FAQ items={courseFaqs.data.items} heading="Questions about the course" eyebrow="Course FAQ" />
  <RelatedPages />
  <CTA heading="Ready to begin your beautician career?" />
</BaseLayout>
