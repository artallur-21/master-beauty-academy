---
import BaseLayout from '@layouts/BaseLayout.astro';
import LocationPage from '@components/LocationPage.astro';
import { getEntry } from 'astro:content';
import { courseSchema, faqSchema, localBusinessSchema, breadcrumbSchema } from '@lib/schema';

const faqs = (await getEntry('faqs', 'hubballi')).data.items;
const schema = [
  localBusinessSchema('hubballi'),
  courseSchema(),
  faqSchema(faqs),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Beautician Course', url: '/beautician-course' },
    { name: 'Hubballi', url: '/beautician-course-hubballi' },
  ]),
];

const usps = [
  { t: 'Gokul Road location', d: 'Easy access from Vidyanagar, Keshwapur, Unkal and Navanagar.' },
  { t: 'PG accommodation help', d: 'We help out-of-town students find verified PG stays near the academy.' },
  { t: 'Senior trainers', d: 'Industry veterans with deep experience in Hubballi-Dharwad salons.' },
  { t: 'Hubballi salon network', d: 'Direct placement support across Hubballi and Dharwad twin-city.' },
];
---

<BaseLayout
  title="Professional Beautician Course in Hubballi — Master Beauty Academy"
  description="Best beautician course in Hubballi at Master Beauty Academy. 15+ modules, certified trainers, live-client practice, morning & evening batches. Gokul Road centre."
  path="/beautician-course-hubballi"
  keywords={['beautician course hubballi', 'beauty academy hubballi', 'beauty parlour course hubballi']}
  schema={schema}
>
  <LocationPage slug="hubballi" faqs={faqs} usps={usps} />
</BaseLayout>
