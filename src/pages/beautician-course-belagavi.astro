---
import BaseLayout from '@layouts/BaseLayout.astro';
import LocationPage from '@components/LocationPage.astro';
import { getEntry } from 'astro:content';
import { courseSchema, faqSchema, localBusinessSchema, breadcrumbSchema } from '@lib/schema';

const faqs = (await getEntry('faqs', 'belagavi')).data.items;
const schema = [
  localBusinessSchema('belagavi'),
  courseSchema(),
  faqSchema(faqs),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Beautician Course', url: '/beautician-course' },
    { name: 'Belagavi', url: '/beautician-course-belagavi' },
  ]),
];

const usps = [
  { t: 'Khade Bazar location', d: 'Heart of Belagavi — auto-reachable from Tilakwadi, Camp and Shahapur.' },
  { t: 'Local placement network', d: 'Partner salons across Belagavi, Tilakwadi, Vadgaon and Hindwadi.' },
  { t: 'Kannada + English instruction', d: 'Modules taught bilingually for clarity on every technique.' },
  { t: 'Live-client studio', d: 'Real-client treatments under senior supervision from week three.' },
];
---

<BaseLayout
  title="Beautician Course in Belagavi | Best Beauty Academy in Belagavi — Master Beauty Academy"
  description="Join the best Beautician Course in Belagavi at Master Beauty Academy — 30 days, ₹40,000, Hydra Facial, Haircutting, Waxing, Hair Botox, Hair Smoothening, Bridal Makeup. Beauty Parlour Course in Belagavi with certificate. Admissions open."
  path="/beautician-course-belagavi"
  keywords={[
    'Beautician Course in Belagavi',
    'Beauty Parlour Course in Belagavi',
    'Beauty Academy in Belagavi',
    'Beauty Training Institute in Belagavi',
    'Beautician Classes in Belagavi',
    'Beauty Parlour Training in Belagavi',
    'Professional Beautician Course in Belagavi',
    'Beauty Therapist Course in Belagavi',
    'Best Beauty Academy in Belagavi',
    'Beauty Courses Near Me',
    'Advanced Beautician Course in Belagavi',
    'Bridal Makeup Course in Belagavi',
    'Hair Styling Course in Belagavi',
    'Hair Cutting Course in Belagavi',
    'Facial Course in Belagavi',
    'Hydra Facial Training in Belagavi',
    'Waxing Course in Belagavi',
    'Hair Botox Training in Belagavi',
    'Hair Smoothening Course in Belagavi',
    'Beauty Parlour Business Course in Belagavi',
    'Beautician Training with Certificate in Belagavi',
    'Job Oriented Beautician Course in Belagavi',
    'Professional Makeup and Beauty Course in Belagavi',
    'Beauty and Wellness Course in Belagavi',
    'Salon Management Course in Belagavi',
  ]}
  schema={schema}
>
  <LocationPage slug="belagavi" faqs={faqs} usps={usps} />
</BaseLayout>
