---
const items = [
  { y: '2023', t: 'Best Makeup Artist — Belagavi, Karnataka', d: 'Priyanka Sakhe awarded Best Makeup Artist at the Global Fame Awards 2023, presented by Bollywood actor Sonu Sood.' },
  { y: '2023', t: 'Award of Excellence in Makeup — LAPT, London', d: 'International recognition from the London Academy of Professional Training for outstanding contribution to makeup artistry.' },
  { y: 'Since 2015', t: '1,000+ Beauty Professionals Trained', d: 'Across India and abroad — many graduates now run their own salons earning up to ₹1 lakh per month.' },
  { y: 'North Karnataka', t: '1,000+ Women Empowered', d: 'Anilkumar Sakhe’s career-coaching programme has helped over a thousand women in North Karnataka build sustainable beauty careers.' },
];
const certifications = [
  'Industry-aligned 9-category curriculum (skincare, hair, wellness, makeup, salon management)',
  'Hygiene & sterilisation protocols matching salon standards',
  'Founder-led practical training in advanced facials, HydraFacial, hair smoothening, makeup',
  'Recognised by partner salon network across Hubli, Belagavi & Karnataka',
];
---

<section class="section bg-cream">
  <div class="container-w container-px grid lg:grid-cols-2 gap-12">
    <div>
      <p class="eyebrow">Awards &amp; recognition</p>
      <h2 class="mt-3 text-balance">Internationally awarded. Locally trusted.</h2>
      <ol class="mt-10 relative border-l-2 border-gold-400/50 pl-7 space-y-7">
        {items.map((i) => (
          <li class="relative">
            <span aria-hidden="true" class="absolute -left-[35px] top-1 w-3 h-3 rounded-full bg-gold-400 ring-4 ring-cream"></span>
            <p class="text-[0.7rem] uppercase tracking-[0.18em] text-brand-700 font-medium">{i.y}</p>
            <h3 class="mt-1 font-serif text-lg leading-tight">{i.t}</h3>
            <p class="mt-1.5 text-sm text-ink-500 leading-relaxed">{i.d}</p>
          </li>
        ))}
      </ol>
    </div>
    <div>
      <p class="eyebrow">Curriculum &amp; standards</p>
      <h2 class="mt-3 text-balance">What we hold ourselves to.</h2>
      <ul class="mt-10 space-y-3">
        {certifications.map((c) => (
          <li class="card !py-4 !px-5 flex items-start gap-4">
            <span class="mt-0.5 w-7 h-7 grid place-items-center rounded-full bg-brand-700 text-white shrink-0">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            </span>
            <p class="text-ink-700 leading-relaxed">{c}</p>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-sm text-ink-500">Our priority is salon-floor outcomes — recognition by salon employers and graduate placements is the certification that matters most.</p>
    </div>
  </div>
</section>
