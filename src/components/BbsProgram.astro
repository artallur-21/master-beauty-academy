---
/**
 * Beautician Business Success Program (BBS) section.
 * Exact copy from PB-017 / PB-018 review-sheet request.
 *
 * Renders a 2-column hero-style block: title/subtitle/desc/CTA on the left,
 * brand image on the right; then a 4-card learning-module grid below.
 */
interface Props {
  /** Optional override id for anchor links */
  id?: string;
}
const { id = 'bbs-program' } = Astro.props;

const modules = [
  {
    title: 'Facial Treatments',
    desc:  'Learn Hydra Facial and Advanced Facial techniques for professional skincare services.',
    icon:  'facial',
  },
  {
    title: 'Advanced Haircutting',
    desc:  'Master modern haircutting styles and salon techniques.',
    icon:  'haircut',
  },
  {
    title: 'Waxing Training',
    desc:  'Professional training in Brazilian Wax and Rica Wax treatments.',
    icon:  'wax',
  },
  {
    title: 'Advanced Hair Treatments',
    desc:  'Learn Hair Botox and Hair Smoothening techniques for advanced hair care services.',
    icon:  'hair-treatment',
  },
];

const icons: Record<string, string> = {
  facial:         'M12 2a7 7 0 0 1 7 7c0 3-2 5-2 7l-1 4h-8l-1-4c0-2-2-4-2-7a7 7 0 0 1 7-7zM9 11a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm6 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm-3 5c1.5 0 2.5-.5 3-1',
  haircut:        'M6 6.5a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7zm0 8.5a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7zm5-9 11 11M11 19 22 8',
  wax:            'M14 4 8 10l-4-2v6l2 8h8l2-8V8l-4 2-2-6h4M9 14h6',
  'hair-treatment': 'M4 7c0-3 2-5 8-5s8 2 8 5v3c0 5-3 9-8 13-5-4-8-8-8-13V7zM9 12l2 2 4-4',
};
---

<section id={id} class="section relative overflow-hidden bg-gradient-to-b from-white via-cream to-white scroll-mt-20">
  <div aria-hidden="true" class="absolute -top-20 -right-32 w-96 h-96 rounded-full bg-gold-300/25 blur-3xl"></div>
  <div aria-hidden="true" class="absolute bottom-0 -left-32 w-96 h-96 rounded-full bg-brand-100/60 blur-3xl"></div>

  <div class="container-w container-px relative">
    {/* Hero block — text left, image right */}
    <div class="grid lg:grid-cols-[1.1fr_1fr] gap-10 lg:gap-14 items-center">
      <div>
        <p class="eyebrow">Beautician Business Success Program</p>
        <h2 class="mt-4 text-balance">Beautician Business Success Program <span class="text-brand-700">(BBS)</span></h2>
        <p class="mt-4 font-serif text-xl lg:text-2xl text-brand-700 leading-snug text-balance">Turn Your Passion Into A Profitable Career.</p>
        <p class="mt-5 max-w-xl text-base lg:text-lg text-ink-500 text-pretty">
          Join the Beautician Business Success Program and build a successful career in the beauty industry. Learn advanced beauty treatments, professional hair services, waxing techniques, and business growth strategies from industry experts.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact" class="btn btn-primary">Enroll Now</a>
          <a href="#bbs-modules" class="btn btn-outline">See the modules</a>
        </div>
      </div>
      <figure class="relative max-w-[520px] mx-auto lg:max-w-[560px] lg:justify-self-end">
        <div aria-hidden="true" class="absolute -inset-5 rounded-3xl bg-gold-400/15 blur-2xl"></div>
        <img
          src="/images/bbs-hero-800.webp"
          srcset="/images/bbs-hero-800.webp 800w, /images/bbs-hero.webp 1200w"
          sizes="(min-width:1024px) 560px, (min-width:640px) 60vw, 92vw"
          alt="Beautician Business Success Program — Master Beauty Academy"
          width="800" height="1000"
          loading="lazy" decoding="async"
          class="relative w-full h-auto object-contain drop-shadow-[0_24px_70px_rgba(0,0,0,0.25)]"
        />
      </figure>
    </div>

    {/* Modules block */}
    <div id="bbs-modules" class="mt-16 lg:mt-20 text-center">
      <p class="eyebrow justify-center">Our Learning Modules</p>
      <h3 class="mt-3 mx-auto max-w-2xl font-serif text-balance">Four modules. Built around what actually earns.</h3>
    </div>

    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4 text-left">
      {modules.map((m) => (
        <li class="card group transition hover:!border-brand-300 hover:shadow-[var(--shadow-lift)]">
          <div class="w-12 h-12 grid place-items-center rounded-xl bg-gradient-to-br from-brand-700 to-brand-900 text-gold-400 mb-4 ring-1 ring-brand-200">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={icons[m.icon]} />
            </svg>
          </div>
          <h4 class="font-serif text-lg leading-tight">{m.title}</h4>
          <p class="mt-2 text-sm text-ink-500 leading-relaxed">{m.desc}</p>
        </li>
      ))}
    </ul>

    <div class="mt-12 text-center">
      <a href="/contact" class="btn btn-gold">Enroll Now</a>
    </div>
  </div>
</section>
