---
interface Item { href: string; eyebrow: string; title: string; desc: string }
interface Props { items?: Item[] }
const defaults: Item[] = [
  { href: '/beautician-course-belagavi', eyebrow: 'Belagavi centre', title: 'Beautician course in Belagavi', desc: 'Khade Bazar location — morning & evening batches, live-client studio.' },
  { href: '/beautician-course-hubballi', eyebrow: 'Hubli centre', title: 'Beautician course in Hubli', desc: 'Gokul Road location — PG help, Hubli-Dharwad salon placement.' },
  { href: '/beautician-course/curriculum', eyebrow: 'Detailed syllabus', title: 'Full 15-module curriculum', desc: 'Module-by-module breakdown of theory, technique and assessment.' },
];
const { items = defaults } = Astro.props;
---
<section class="section bg-cream">
  <div class="container-w container-px">
    <p class="eyebrow">Related</p>
    <h2 class="mt-3 max-w-2xl text-balance">Continue exploring.</h2>
    <ul class="mt-10 grid gap-5 md:grid-cols-3">
      {items.map((i) => (
        <li>
          <a href={i.href} class="card block h-full hover:!border-brand-300">
            <p class="text-[0.7rem] uppercase tracking-[0.18em] text-gold-500 font-medium">{i.eyebrow}</p>
            <h3 class="mt-2 font-serif text-lg leading-tight">{i.title}</h3>
            <p class="mt-2 text-sm text-ink-500 leading-relaxed">{i.desc}</p>
            <span class="mt-4 inline-block text-sm text-brand-700 font-medium">Open →</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
