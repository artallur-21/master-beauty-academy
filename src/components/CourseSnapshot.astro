---
import { MODULES } from '@lib/site';
const preview = MODULES.slice(0, 3);
---
<section class="section">
  <div class="container-w container-px">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
      <div class="max-w-2xl">
        <p class="eyebrow">Course Snapshot</p>
        <h2 class="mt-3 text-balance">15+ professional modules. One industry-ready beautician.</h2>
        <p class="mt-4 text-ink-500 text-pretty">From skin science fundamentals to advanced body therapies — every module is taught with live demonstrations, supervised practice and assessments.</p>
      </div>
      <a href="/beautician-course/curriculum" class="btn btn-outline">View Full Curriculum</a>
    </div>

    <ol class="mt-12 grid gap-5 md:grid-cols-3">
      {preview.map((m) => (
        <li class="card">
          <span class="font-serif text-gold-500 text-sm tracking-widest">MODULE {String(m.n).padStart(2, '0')}</span>
          <h3 class="mt-2 font-serif text-xl">{m.title}</h3>
          <p class="mt-2 text-ink-500">{m.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
