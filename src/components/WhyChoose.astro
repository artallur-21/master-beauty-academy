---
const items = [
  { t: 'Award-Winning Founders', d: 'Priyanka Sakhe — LAPT London, Global Fame Awards 2023. Anilkumar Sakhe — 15+ years in business development.' },
  { t: '9 Complete Categories', d: 'Threading, facials, HydraFacial, hair, makeup, salon management and advanced hair treatments — taught hands-on.' },
  { t: 'Founder-Led Training', d: 'You learn directly from Priyanka and Anilkumar — not junior staff. Every technique demonstrated personally.' },
  { t: '30-Day Intensive', d: 'A focused programme that transforms passion into a profession in one month — no drawn-out filler hours.' },
  { t: 'Founder-Signed Certificate', d: 'Industry-recognised certificate signed by the founders. Verifiable, named, and accepted by salons across India.' },
  { t: '1,000+ Graduates', d: 'Many now earn up to ₹1 lakh per month running their own salons or freelance practices across India and abroad.' },
];
---
<section class="section bg-cream">
  <div class="container-w container-px text-center">
    <p class="eyebrow justify-center">Why Master Beauty Academy</p>
    <h2 class="mt-3 mx-auto max-w-2xl text-balance">A curriculum engineered for working professionals — not classroom theorists.</h2>
    <p class="mt-4 mx-auto max-w-2xl text-ink-500 text-pretty">Every category pairs technique training with founder-led demonstrations, hygiene protocols, product knowledge and salon-readiness — the things that actually decide if a beauty professional thrives.</p>

    <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3 text-left">
      {items.map((i) => (
        <li class="card">
          <div class="w-10 h-10 grid place-items-center rounded-full bg-brand-50 text-brand-700 mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          </div>
          <h3 class="font-serif text-xl">{i.t}</h3>
          <p class="mt-2 text-ink-500">{i.d}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
