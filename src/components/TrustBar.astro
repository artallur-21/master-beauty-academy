---
import { SITE } from '@lib/site';
const stats = [
  { v: SITE.studentCount, l: 'Students Trained' },
  { v: SITE.yearsExperience, l: 'Years Experience' },
  { v: '2', l: 'Award-Winning Founders' },
  { v: SITE.centresCount + ' Centres', l: 'Hubli · Belagavi' },
];
---
<section aria-label="Trust signals" class="relative -mt-px bg-white border-y border-ink-200">
  <div class="container-w container-px py-6 lg:py-7">
    <dl class="grid grid-cols-2 sm:grid-cols-4 gap-y-5 gap-x-6 text-center divide-x divide-ink-200">
      {stats.map((s) => (
        <div class="px-2">
          <dt class="text-[0.65rem] uppercase tracking-[0.18em] text-gold-500 font-medium">{s.l}</dt>
          <dd class="font-serif text-2xl lg:text-[1.65rem] text-brand-900 mt-1.5">{s.v}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
