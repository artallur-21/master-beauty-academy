---
const images = [
  { src: '/images/student-1.webp', label: 'Graduate Portfolio' },
  { src: '/images/student-2.webp', label: 'Student Showcase' },
  { src: '/images/student-3.webp', label: 'Graduate Portfolio' },
  { src: '/images/course-1.webp', label: 'Featured Graduate' },
  { src: '/images/student-4.webp', label: 'Student Showcase' },
  { src: '/images/course-2.webp', label: 'Graduate Portfolio' },
  { src: '/images/student-5.webp', label: 'Graduation Day' },
  { src: '/images/course-3.webp', label: 'Featured Graduate' },
  { src: '/images/student-6.webp', label: 'Graduate Portfolio' },
];
---

<section class="section">
  <div class="container-w container-px text-center">
    <p class="eyebrow justify-center">Student Gallery</p>
    <h2 class="mt-3 mx-auto max-w-2xl text-balance">Real graduates. Real careers.</h2>
    <p class="mt-4 mx-auto max-w-2xl text-ink-500 text-pretty">
      A glimpse into the work and milestones of Master Beauty Academy students across Hubli and Belagavi.
    </p>
  </div>

  {/* Edge-bleed carousel — 5 across on desktop, snap, momentum scroll on mobile */}
  <div class="relative mt-12">
    <div
      data-gallery-track
      class="flex gap-3 sm:gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth px-5 sm:px-8 lg:px-12 pb-4 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
    >
      {images.map((img, i) => (
        <figure class="snap-start shrink-0 w-[78vw] sm:w-[42vw] md:w-[30vw] lg:w-[calc((100%-4rem)/5)] aspect-[4/5] rounded-xl overflow-hidden ring-1 ring-ink-200 bg-ink-100 relative group">
          <img
            src={img.src}
            alt={img.label}
            width="800" height="1000"
            loading={i < 5 ? 'eager' : 'lazy'}
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
          <figcaption class="absolute bottom-3 left-3 text-xs font-medium text-ink-900/90 bg-white/85 backdrop-blur px-2.5 py-1 rounded-full">{img.label}</figcaption>
        </figure>
      ))}
    </div>

    {/* Prev / next controls (desktop) */}
    <div class="container-w container-px hidden lg:flex justify-end gap-2 mt-4">
      <button type="button" data-gallery-prev aria-label="Previous photo"
        class="w-10 h-10 grid place-items-center rounded-full bg-white border border-ink-200 text-ink-700 hover:text-brand-700 hover:border-brand-300 transition disabled:opacity-40">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button type="button" data-gallery-next aria-label="Next photo"
        class="w-10 h-10 grid place-items-center rounded-full bg-white border border-ink-200 text-ink-700 hover:text-brand-700 hover:border-brand-300 transition disabled:opacity-40">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</section>

<script>
  const track = document.querySelector<HTMLElement>('[data-gallery-track]');
  if (track) {
    const step = () => {
      const first = track.querySelector('figure');
      if (!first) return track.clientWidth * 0.8;
      const rect = first.getBoundingClientRect();
      // Scroll roughly one card + gap
      const gap = parseFloat(getComputedStyle(track).columnGap || '16');
      return rect.width + gap;
    };
    document.querySelector('[data-gallery-prev]')?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    document.querySelector('[data-gallery-next]')?.addEventListener('click', () => track.scrollBy({ left:  step(), behavior: 'smooth' }));
  }
</script>
