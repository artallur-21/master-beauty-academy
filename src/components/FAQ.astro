---
interface Item { q: string; a: string }
interface Props { items: Item[]; heading?: string; eyebrow?: string; lead?: string }
const { items, heading = 'Frequently Asked Questions', eyebrow = 'Answers', lead } = Astro.props;
---
<section class="section bg-white">
  <div class="container-w container-px grid gap-12 lg:grid-cols-[1fr_2fr]">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="mt-3 text-balance">{heading}</h2>
      {lead && <p class="mt-4 text-ink-500 text-pretty">{lead}</p>}
    </div>
    <div class="divide-y divide-ink-200 border-y border-ink-200">
      {items.map((item, i) => (
        <details class="group py-5" open={i === 0}>
          <summary class="flex items-start justify-between gap-4 cursor-pointer">
            <h3 class="font-serif text-lg leading-snug text-ink-900">{item.q}</h3>
            <span aria-hidden="true" class="mt-1 w-6 h-6 grid place-items-center rounded-full border border-ink-300 text-ink-500 transition-transform group-open:rotate-45">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            </span>
          </summary>
          <p class="mt-3 text-ink-700 leading-relaxed text-pretty">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
