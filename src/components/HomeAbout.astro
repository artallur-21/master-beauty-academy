---
import { FOUNDERS } from '@lib/site';
---
<section class="section bg-white">
  <div class="container-w container-px text-center">
    <p class="eyebrow justify-center">About the academy</p>
    <h2 class="mt-3 text-balance mx-auto max-w-3xl">Founded by award-winning beauty professionals.</h2>
    <p class="mt-5 max-w-2xl mx-auto text-ink-500 text-pretty">
      Master Beauty Academy was founded by <strong class="text-ink-900">Anilkumar Sakhe</strong> and <strong class="text-ink-900">Priyanka Sakhe</strong> with one stubborn idea — to raise the standard of every beauty professional who passes through their doors. Today, 1,000+ graduates work in salons across India, and many run their own.
    </p>
  </div>

  <div class="container-w container-px mt-14 grid gap-8 lg:gap-12 md:grid-cols-2">
    {FOUNDERS.map((f, i) => (
      <article class="grid grid-cols-[110px_1fr] sm:grid-cols-[140px_1fr] gap-5 sm:gap-6 items-start">
        <figure class="aspect-[4/5] rounded-2xl overflow-hidden ring-1 ring-ink-200 bg-ink-900">
          <img
            src={f.photo}
            srcset={`${f.photoSmall} 600w, ${f.photo} 1200w`}
            sizes="(min-width:1024px) 140px, 110px"
            alt={`${f.name} — ${f.role}`}
            width="560" height="700"
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            class="w-full h-full object-cover object-top"
          />
        </figure>
        <div>
          <p class="text-[0.7rem] uppercase tracking-[0.18em] text-gold-500 font-medium">{f.role}</p>
          <h3 class="mt-1.5 font-serif text-xl leading-tight">{f.name}</h3>
          <ul class="mt-3 space-y-1 text-sm text-ink-700">
            {f.credentials.slice(0, 2).map((c) => (
              <li class="flex gap-2"><span class="text-brand-700 mt-1 shrink-0">✦</span>{c}</li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </div>

  <div class="container-w container-px mt-10 text-center">
    <a href="/about" class="btn btn-outline">Read the full story</a>
  </div>
</section>
