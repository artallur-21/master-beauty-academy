---
import { SITE, LOCATIONS } from '@lib/site';

const upcomingBatches = LOCATIONS.map((l) => ({
  centre: l.city,
  start: 'Next intake — call to confirm',
  time: 'Morning & Evening · Mon–Sat',
}));
---

<section class="section bg-white">
  <div class="container-w container-px text-center">
    <p class="eyebrow justify-center">Course fee &amp; batch schedule</p>
    <h2 class="mt-3 mx-auto max-w-2xl text-balance">One transparent fee. Everything included.</h2>
    <p class="mt-4 mx-auto max-w-2xl text-ink-500 text-pretty">A single, flat fee covering all 9 categories, founder-led training, materials and certification. No hidden add-ons.</p>

    <div class="mt-12 grid gap-8 md:grid-cols-[1.2fr_1fr] text-left">
      <div class="card !p-0 overflow-hidden !border-brand-200 !ring-2 !ring-brand-100 relative">
        <div class="grad-hero text-white px-8 py-7">
          <span class="absolute top-4 right-4 bg-gold-400 text-ink-900 text-[10px] font-bold tracking-[0.18em] uppercase px-3 py-1 rounded-full">Flagship</span>
          <p class="text-[0.7rem] uppercase tracking-[0.18em] text-gold-400 font-medium">Professional Beautician Course</p>
          <p class="mt-4 flex items-baseline gap-2">
            <span class="font-serif text-5xl text-white">₹{SITE.courseFee.toLocaleString('en-IN')}</span>
            <span class="text-ink-200 text-sm">all-inclusive</span>
          </p>
          <p class="mt-2 text-ink-200 text-sm">{SITE.courseDurationDays} days · Hubli or Belagavi</p>
        </div>
        <div class="p-8">
          <p class="text-xs uppercase tracking-widest text-gold-500 font-medium">What's included</p>
          <ul class="mt-4 grid sm:grid-cols-2 gap-x-6 gap-y-2 text-sm text-ink-700">
            <li class="flex gap-2"><span class="text-brand-700 mt-0.5">✓</span>All 9 training categories</li>
            <li class="flex gap-2"><span class="text-brand-700 mt-0.5">✓</span>Threading, waxing, brizzlin wax</li>
            <li class="flex gap-2"><span class="text-brand-700 mt-0.5">✓</span>Advanced facials + HydraFacial</li>
            <li class="flex gap-2"><span class="text-brand-700 mt-0.5">✓</span>Manicure &amp; pedicure</li>
            <li class="flex gap-2"><span class="text-brand-700 mt-0.5">✓</span>Hair spa, scalp, anti-hair-fall</li>
            <li class="flex gap-2"><span class="text-brand-700 mt-0.5">✓</span>8 haircut styles + styling</li>
            <li class="flex gap-2"><span class="text-brand-700 mt-0.5">✓</span>Hair smoothening + Botox</li>
            <li class="flex gap-2"><span class="text-brand-700 mt-0.5">✓</span>Basic Makeup Technician</li>
            <li class="flex gap-2"><span class="text-brand-700 mt-0.5">✓</span>Salon management training</li>
            <li class="flex gap-2"><span class="text-brand-700 mt-0.5">✓</span>Founder-signed certificate</li>
          </ul>
          <a href="/contact" class="btn btn-primary mt-7">Enrol now</a>
        </div>
      </div>

      <aside class="space-y-5">
        <div class="card !p-7 !bg-brand-50 !border-brand-100">
          <p class="eyebrow">EMI &amp; instalments</p>
          <h3 class="mt-3 font-serif text-xl">Pay across 2 or 3 months.</h3>
          <p class="mt-3 text-ink-700 text-sm leading-relaxed">Interest-free instalment plans available — talk to our counsellor for your preferred schedule.</p>
          <a href="/contact" class="btn btn-primary mt-5 !py-2.5 !px-5 text-sm">Get EMI options</a>
        </div>
        <div class="card !p-7">
          <p class="eyebrow">Upcoming batches</p>
          <ul class="mt-4 space-y-3 text-sm">
            {upcomingBatches.map((b) => (
              <li class="border-b border-ink-200 last:border-0 pb-3 last:pb-0">
                <p class="font-medium text-ink-900">{b.centre} centre</p>
                <p class="text-ink-700">{b.time}</p>
                <p class="text-ink-500 text-xs mt-0.5">{b.start}</p>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>
