---
/**
 * Video testimonial cards.
 * Pass `videos` with YouTube/Vimeo URLs to enable real video; defaults render
 * a branded "Watch story" placeholder card that still looks intentional.
 */
interface Video {
  name: string;
  outcome: string;
  city: string;
  thumb?: string;
  videoUrl?: string;
  duration?: string;
}
const defaults: Video[] = [
  { name: 'Priya Patil',     outcome: 'From student to senior beautician',        city: 'Belagavi', thumb: '/images/student-1.webp', duration: '0:48' },
  { name: 'Anjali Kulkarni', outcome: 'Opened her own parlour in Vidyanagar',     city: 'Hubli', thumb: '/images/student-2.webp', duration: '1:12' },
  { name: 'Shruti Desai',    outcome: 'Salon placement in 2 weeks of graduating', city: 'Belagavi', thumb: '/images/student-3.webp', duration: '0:54' },
];
const { videos = defaults } = Astro.props as { videos?: Video[] };
---

<section class="section bg-white">
  <div class="container-w container-px">
    <p class="eyebrow">Video stories</p>
    <h2 class="mt-3 max-w-2xl text-balance">Hear it from our graduates.</h2>
    <p class="mt-4 max-w-2xl text-ink-500 text-pretty">Short success stories from students who walked in with no experience and walked out salon-ready.</p>

    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {videos.map((v) => (
        <li>
          <a
            href={v.videoUrl ?? '/testimonials'}
            class="card !p-0 overflow-hidden block h-full flex flex-col group"
            target={v.videoUrl ? '_blank' : undefined}
            rel={v.videoUrl ? 'noopener' : undefined}
          >
            <div class="aspect-[16/10] bg-ink-100 relative overflow-hidden">
              {v.thumb && <img src={v.thumb} alt={`${v.name} — ${v.outcome}`} width="800" height="500" loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.04]" />}
              <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/15 to-transparent"></div>
              <div class="absolute inset-0 grid place-items-center">
                <span class="w-14 h-14 rounded-full bg-white/95 grid place-items-center shadow-[var(--shadow-lift)] group-hover:scale-110 transition-transform">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" class="text-brand-700 ml-1" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                </span>
              </div>
              {v.duration && <span class="absolute bottom-3 right-3 bg-black/65 text-white text-[11px] px-2 py-0.5 rounded font-mono tracking-tight">{v.duration}</span>}
            </div>
            <div class="p-6 flex-1 flex flex-col">
              <p class="font-serif text-lg leading-snug">{v.name}</p>
              <p class="mt-1 text-sm text-ink-500">{v.outcome}</p>
              <span class="mt-3 text-[11px] uppercase tracking-[0.16em] text-gold-500">{v.city}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
