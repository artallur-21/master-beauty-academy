  rel="noopener"
  aria-label="Chat with us on WhatsApp"
  class="fixed bottom-5 right-5 z-50 w-14 h-14 rounded-full bg-[#25D366] text-white grid place-items-center shadow-[0_8px_24px_-6px_rgba(37,211,102,0.6)] hover:scale-105 transition-transform"
>
