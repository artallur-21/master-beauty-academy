---
const blocks = [
  { time: '9:30 am',  t: 'Arrival & set-up',                 d: 'Students sterilise their stations, prep tools and review the day’s protocol with the trainer.' },
  { time: '10:00 am', t: 'Theory block',                     d: '30–45 minutes of focused theory: skin science, product chemistry or the technique you’ll practise today.' },
  { time: '11:00 am', t: 'Live demo',                        d: 'The senior trainer performs the full technique once at normal speed, once narrated step by step.' },
  { time: '11:45 am', t: 'Peer & mannequin practice',        d: 'You work the technique on a peer or training mannequin while the trainer circulates and corrects in real time.' },
  { time: '12:45 pm', t: 'Break',                            d: 'Reset, review notes, refill water — a real salon day has no slack so we train for stamina too.' },
  { time: '1:15 pm',  t: 'Live-client session (from week 2)', d: 'Real treatments on real clients with supervised pricing, hygiene and consultation flow.' },
  { time: '2:30 pm',  t: 'Debrief & assessment',             d: 'Each student gets individual feedback. Common mistakes go on the board. Day ends with a 5-question check-in.' },
];

const highlights = [
  { t: 'Founder-led demos',   d: 'Every new technique is first demonstrated by Priyanka or Anilkumar.' },
  { t: 'Real-client practice', d: 'You work on real clients from week 2 — supervised, not solo.' },
  { t: 'Salon stamina',       d: 'We deliberately train you for the rhythm of a real salon floor.' },
];
---
<section class="section bg-cream">
  <div class="container-w container-px">
    <div class="text-center max-w-3xl mx-auto">
      <p class="eyebrow justify-center">Day in the life of a student</p>
      <h2 class="mt-3 text-balance">A typical day inside the academy.</h2>
      <p class="mt-4 text-ink-500 text-pretty">Structured, supervised, and engineered around real practice. Not a single hour wasted on filler.</p>
    </div>

    <div class="mt-14 grid gap-10 lg:gap-14 lg:grid-cols-[1fr_1fr] items-start">
      {/* Left — hourly timeline */}
      <ol class="relative border-l-2 border-brand-200 pl-7 space-y-7">
        {blocks.map((b) => (
          <li class="relative">
            <span aria-hidden="true" class="absolute -left-[35px] top-1 w-3 h-3 rounded-full bg-brand-700 ring-4 ring-cream"></span>
            <p class="text-[0.7rem] uppercase tracking-[0.18em] text-gold-500 font-medium font-mono">{b.time}</p>
            <h3 class="mt-1 font-serif text-lg leading-tight">{b.t}</h3>
            <p class="mt-1.5 text-ink-700 leading-relaxed">{b.d}</p>
          </li>
        ))}
      </ol>

      {/* Right — visual + highlights panel */}
      <aside class="space-y-6 lg:sticky lg:top-28">
        <figure class="relative">
          <div aria-hidden="true" class="absolute -inset-4 rounded-3xl bg-gold-400/10 blur-2xl"></div>
          <div class="relative rounded-2xl overflow-hidden ring-1 ring-ink-200 shadow-[var(--shadow-lift)] aspect-[5/6] bg-ink-100">
            <img
              src="/images/categories/facial-treatments.webp"
              alt="Facial treatment training day at Master Beauty Academy"
              width="900" height="1080"
              loading="lazy" decoding="async"
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 via-black/15 to-transparent p-6 text-white">
              <p class="text-[0.65rem] uppercase tracking-[0.18em] text-gold-400 font-medium">A working day</p>
              <p class="mt-1 font-serif text-xl leading-tight">Hands-on the whole way through.</p>
            </div>
          </div>
        </figure>

        <ul class="grid gap-3">
          {highlights.map((h) => (
            <li class="card !p-5 flex items-start gap-4">
              <span class="mt-0.5 w-9 h-9 grid place-items-center rounded-full bg-brand-50 text-brand-700 shrink-0">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              </span>
              <div>
                <h3 class="font-serif text-base leading-tight">{h.t}</h3>
                <p class="mt-1 text-sm text-ink-500 leading-relaxed">{h.d}</p>
              </div>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</section>
