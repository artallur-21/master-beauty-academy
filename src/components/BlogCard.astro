---
interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  readingTime?: string;
  tag?: string;
  index?: number;
}
const { href, title, description, pubDate, readingTime, tag, index = 0 } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' });

// Rotate through three branded gradient hero treatments
const variants = [
  'from-brand-800 via-brand-700 to-brand-900',
  'from-brand-900 via-ink-900 to-brand-800',
  'from-ink-900 via-brand-900 to-brand-700',
];
const grad = variants[index % variants.length];
const initial = title.trim().charAt(0).toUpperCase();
---
<a href={href} class="card !p-0 overflow-hidden block h-full flex flex-col group">
  <div class={`aspect-[16/10] bg-gradient-to-br ${grad} relative overflow-hidden`}>
    <div aria-hidden="true" class="absolute inset-0 opacity-[0.10] mix-blend-screen" style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.6) 1px, transparent 0); background-size: 24px 24px;"></div>
    <div aria-hidden="true" class="absolute -right-10 -top-10 w-48 h-48 rounded-full bg-gold-400/15 blur-2xl"></div>
    <div aria-hidden="true" class="absolute -left-6 bottom-0 font-serif text-[10rem] leading-none text-gold-400/15 select-none">{initial}</div>
    <div class="relative h-full p-6 flex flex-col justify-between text-white">
      {tag && <span class="self-start text-[0.65rem] font-medium uppercase tracking-[0.18em] text-gold-400 bg-white/5 backdrop-blur px-2.5 py-1 rounded-full border border-white/15">{tag}</span>}
      <span class="font-serif text-xl leading-tight max-w-[14rem] text-balance">{title}</span>
    </div>
  </div>
  <div class="p-6 flex-1 flex flex-col">
    <p class="text-xs text-ink-500">{fmt(pubDate)}{readingTime && <> · {readingTime}</>}</p>
    <p class="mt-2 text-sm text-ink-500 line-clamp-3 leading-relaxed">{description}</p>
    <span class="mt-4 text-sm text-brand-700 font-medium group-hover:underline">Read article →</span>
  </div>
</a>
