---
import { SITE } from '@lib/site';
interface Props {
  eyebrow?: string;
  heading: string;
  sub?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  variant?: 'home' | 'inner';
}
const {
  eyebrow = 'Professional Beautician Course',
  heading,
  sub,
  primaryCta = { label: 'Enquire Now', href: '/contact' },
  secondaryCta = { label: 'Download Brochure', href: '/contact#brochure' },
  variant = 'home',
} = Astro.props;
---

<section class:list={['relative overflow-hidden', variant === 'home' ? 'text-white' : 'pt-16 pb-12 bg-cream']}>
  {variant === 'home' && (
    <>
      <div class="absolute inset-0">
        <div class="absolute inset-0 grad-hero"></div>
        <div aria-hidden="true" class="absolute inset-0 opacity-[0.06] mix-blend-screen" style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.6) 1px, transparent 0); background-size: 32px 32px;"></div>
      </div>

      <div class="container-w container-px relative z-10 pt-16 pb-20 lg:pt-24 lg:pb-28">
        <div class="grid lg:grid-cols-[1.05fr_1fr] gap-10 lg:gap-14 items-center">
          {/* Left — text */}
          <div>
            <p class="eyebrow !text-gold-400 [&::before]:bg-gold-400">{eyebrow}</p>

            {/* Prominent brand name above the headline */}
            <p class="mt-5 font-serif text-3xl sm:text-4xl lg:text-[2.75rem] leading-[1.05] tracking-tight">
              <span class="text-white">Master Beauty</span>
              <span class="text-gold-400"> Academy</span>
            </p>

            <h1 class="mt-4 text-balance text-white text-[2rem] sm:text-[2.4rem] lg:text-[2.75rem] leading-[1.08] font-serif">{heading}</h1>
            {sub && <p class="mt-6 max-w-xl text-base lg:text-lg text-pretty text-ink-200">{sub}</p>}
            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a href={primaryCta.href} class="btn btn-gold">{primaryCta.label}</a>
              <a href={secondaryCta.href} class="btn btn-outline !bg-transparent !text-white !border-white/30 hover:!border-white">{secondaryCta.label}</a>
            </div>
          </div>

          {/* Right — hero image. object-contain so the full image is visible at every size; no cropping. */}
          <figure class="relative">
            <div aria-hidden="true" class="absolute -inset-4 rounded-3xl bg-gold-400/10 blur-2xl"></div>
            <div class="relative mx-auto max-w-[520px]">
              <img
                src="/images/master-herosection-800.webp"
                srcset="/images/master-herosection-800.webp 800w, /images/master-herosection.webp 1200w"
                sizes="(min-width:1024px) 520px, (min-width:640px) 60vw, 90vw"
                alt="Master Beauty Academy"
                width="800" height="1000"
                fetchpriority="high"
                decoding="async"
                class="w-full h-auto object-contain drop-shadow-[0_20px_60px_rgba(0,0,0,0.45)]"
              />
            </div>
          </figure>
        </div>
      </div>
    </>
  )}
  {variant === 'inner' && (
    <div class="container-w container-px relative">
      <div class="max-w-3xl">
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="mt-4 text-balance">{heading}</h1>
        {sub && <p class="mt-6 max-w-2xl text-lg text-pretty text-ink-700">{sub}</p>}
      </div>
    </div>
  )}
</section>
