---
/**
 * Founder's message block — image left, signed letter-style copy right.
 * Defaults are editable placeholders; swap with real founder bio when available.
 */
interface Props {
  name?: string;
  role?: string;
  photo?: string;
  message?: string;
  yearsExperience?: string;
}
const {
  name = 'Founder, Master Beauty Academy',
  role = 'Senior Beauty Educator',
  photo = '/images/student-3.webp',
  yearsExperience = '15+',
  message = `Beauty education in India has too often been about handing out certificates. We started Master Beauty Academy with one stubborn idea — train every student until they walk into any salon and outperform from day one.\n\nWe cap our batches at 12. We refuse to skip live-client days. We teach the science of skin, not just the steps. And we don't graduate anyone who isn't truly ready.\n\nThis academy exists for one reason — to raise the standard of every beautician who passes through our doors.`,
} = Astro.props;
---

<section class="section bg-white">
  <div class="container-w container-px grid gap-10 lg:grid-cols-[360px_1fr] lg:gap-16 items-start">
    <figure class="relative">
      <div class="aspect-[4/5] rounded-2xl overflow-hidden ring-1 ring-ink-200 bg-ink-100">
        <img src={photo} alt={`${name} — ${role}`} width="720" height="900" loading="lazy" decoding="async" class="w-full h-full object-cover" />
      </div>
      <div class="absolute -bottom-5 left-5 bg-white rounded-xl px-4 py-3 shadow-[var(--shadow-soft)] border border-ink-200">
        <p class="text-[0.65rem] uppercase tracking-[0.18em] text-gold-500">Founder</p>
        <p class="font-serif text-lg mt-0.5 leading-tight">{name}</p>
        <p class="text-xs text-ink-500 mt-1">{yearsExperience} years · {role}</p>
      </div>
    </figure>

    <div>
      <p class="eyebrow">Founder's message</p>
      <h2 class="mt-3 text-balance">"We don't graduate anyone who isn't truly salon-ready."</h2>
      <div class="mt-7 space-y-5 text-ink-700 text-[1.0625rem] leading-relaxed text-pretty">
        {message.split('\n\n').map((p) => <p>{p}</p>)}
      </div>
      <p class="mt-7 font-serif text-xl">— {name}</p>
    </div>
  </div>
</section>
