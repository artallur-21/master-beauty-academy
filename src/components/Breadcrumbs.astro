---
interface Crumb { name: string; url: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="container-w container-px pt-6 text-xs text-ink-500">
  <ol class="flex flex-wrap items-center gap-1.5">
    {items.map((c, i) => (
      <li class="flex items-center gap-1.5">
        {i < items.length - 1 ? (
          <a href={c.url} class="hover:text-brand-700">{c.name}</a>
        ) : (
          <span aria-current="page" class="text-ink-700">{c.name}</span>
        )}
        {i < items.length - 1 && <span aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>
