---
const facilities = [
  { t: 'Live-Client Studio', d: 'A fully-equipped salon studio inside the academy where students perform supervised treatments on real clients from week three.' },
  { t: 'Demonstration Theatre', d: 'Tiered viewing for live technique demos so every student has a clear, close-up line of sight.' },
  { t: 'Skin Analysis Bay', d: 'Magnifying lamps, Wood’s lamp and digital skin scanners for textbook-grade analysis training.' },
  { t: 'Product Library', d: 'Working stock of 40+ professional brands across cleansers, serums, masks and bleach formats — students learn brand chemistry first-hand.' },
  { t: 'Hygiene & Sterilisation Zone', d: 'Dedicated UV cabinet, autoclave and disposable-tool protocols matching industry standards.' },
  { t: 'Career Lounge', d: 'Interview prep, portfolio reviews and salon-readiness coaching in the final week of every batch.' },
];
---

<section class="section bg-cream">
  <div class="container-w container-px text-center">
    <p class="eyebrow justify-center">Facilities &amp; infrastructure</p>
    <h2 class="mt-3 mx-auto max-w-2xl text-balance">Built for hands-on mastery, not classroom theory.</h2>
    <p class="mt-4 mx-auto max-w-2xl text-ink-500 text-pretty">Every space inside our academies is designed around one rule — students should spend more time doing than listening.</p>
    <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3 text-left">
      {facilities.map((f) => (
        <li class="card">
          <div class="w-10 h-10 grid place-items-center rounded-full bg-brand-50 text-brand-700 mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 21h18M5 21V8l7-5 7 5v13M9 21v-6h6v6"/></svg>
          </div>
          <h3 class="font-serif text-lg">{f.t}</h3>
          <p class="mt-2 text-ink-500 text-sm leading-relaxed">{f.d}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
