---
import { LOCATIONS } from '@lib/site';
---
<section class="section bg-cream">
  <div class="container-w container-px text-center">
    <p class="eyebrow justify-center">Our Centres</p>
    <h2 class="mt-3 mx-auto max-w-2xl text-balance">Two flagship academies. Same uncompromising standards.</h2>
    <div class="mt-12 grid gap-8 md:grid-cols-2 text-left">
      {LOCATIONS.map((l) => (
        <article class="card !p-0 overflow-hidden flex flex-col">
          <div class="aspect-[16/9] bg-ink-200 relative">
            <iframe
              src={l.mapEmbed}
              title={`Map of ${l.city} centre`}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="w-full h-full"
              aria-hidden="false"
            ></iframe>
          </div>
          <div class="p-7 flex-1 flex flex-col">
            <h3 class="font-serif text-2xl">{l.city} Academy</h3>
            <address class="not-italic mt-3 text-ink-500 leading-relaxed">
              {l.addressLine}<br />
              {'addressLine2' in l && l.addressLine2 && <>{l.addressLine2}<br /></>}
              {l.locality}, {l.city}, {l.region} {l.postalCode}
            </address>
            <p class="mt-3 text-sm text-ink-500">
              <span class="font-medium text-ink-900">Phone:</span> <a href={`tel:${l.phone}`} class="text-brand-700 hover:underline">{l.phone}</a>
            </p>
            <div class="mt-6 flex flex-wrap gap-2 mt-auto pt-6">
              <a href={`/beautician-course-${l.slug}`} class="btn btn-primary !py-2.5 !px-5 text-sm">View {l.city} Page</a>
              <a href={`tel:${l.phone}`} class="btn btn-outline !py-2.5 !px-5 text-sm">Call Centre</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
