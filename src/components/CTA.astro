---
import { SITE } from '@lib/site';
interface Props { heading?: string; sub?: string }
const {
  heading = "Begin your beauty career with India's most awarded training academy.",
  sub = 'Speak to our counsellor — fees, batch timings, EMI, and career advice. No commitment.',
} = Astro.props;
---
<section class="section">
  <div class="container-w container-px">
    <div class="grad-hero text-white rounded-3xl p-8 sm:p-10 lg:p-14 relative overflow-hidden grid lg:grid-cols-[1.15fr_1fr] gap-10 lg:gap-14 items-center">
      <div>
        <p class="eyebrow !text-gold-400 [&::before]:bg-gold-400">Take the next step</p>
        <h2 class="mt-4 text-white text-balance">{heading}</h2>
        <p class="mt-4 text-ink-200 text-pretty">{sub}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact" class="btn btn-gold">Get Free Counselling</a>
          <a href={`https://wa.me/${SITE.phoneWhatsapp}`} rel="noopener" class="btn btn-outline !bg-transparent !text-white !border-white/30 hover:!border-white">WhatsApp Us</a>
        </div>
      </div>
      <figure class="relative max-w-[420px] mx-auto lg:max-w-[460px] lg:justify-self-end">
        <div aria-hidden="true" class="absolute -inset-6 rounded-3xl bg-gold-400/10 blur-3xl"></div>
        <img
          src="/images/cta-master-700.webp"
          srcset="/images/cta-master-700.webp 700w, /images/cta-master.webp 1200w"
          sizes="(min-width:1024px) 460px, (min-width:640px) 60vw, 90vw"
          alt="Master Beauty Academy — begin your beauty career"
          width="800" height="1000"
          loading="lazy" decoding="async"
          class="relative w-full h-auto object-contain drop-shadow-[0_24px_70px_rgba(0,0,0,0.55)]"
        />
      </figure>
    </div>
  </div>
</section>
