---
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' });
---
<section class="section bg-cream">
  <div class="container-w container-px">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
      <div class="max-w-2xl">
        <p class="eyebrow">From the Journal</p>
        <h2 class="mt-3 text-balance">Career guidance & beauty industry insights.</h2>
      </div>
      <a href="/blog" class="btn btn-outline">All Articles</a>
    </div>
    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {posts.map((p) => (
        <li>
          <a href={`/blog/${p.slug}`} class="card !p-0 overflow-hidden block h-full flex flex-col">
            <div class="aspect-[16/10] bg-gradient-to-br from-brand-100 to-brand-50"></div>
            <div class="p-6 flex-1 flex flex-col">
              <p class="text-xs text-ink-500">{fmt(p.data.pubDate)}</p>
              <h3 class="mt-2 font-serif text-lg leading-snug">{p.data.title}</h3>
              <p class="mt-2 text-sm text-ink-500 line-clamp-3">{p.data.description}</p>
              <span class="mt-4 text-sm text-brand-700 font-medium">Read article →</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
