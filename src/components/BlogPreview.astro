---
import { getCollection } from 'astro:content';
import BlogCard from './BlogCard.astro';
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---
<section class="section bg-cream">
  <div class="container-w container-px">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
      <div class="max-w-2xl">
        <p class="eyebrow">From the Journal</p>
        <h2 class="mt-3 text-balance">Career guidance & beauty industry insights.</h2>
      </div>
      <a href="/blog" class="btn btn-outline">All Articles</a>
    </div>
    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {posts.map((p, i) => (
        <li>
          <BlogCard
            href={`/blog/${p.slug}`}
            title={p.data.title}
            description={p.data.description}
            pubDate={p.data.pubDate}
            readingTime={p.data.readingTime}
            tag={p.data.tags?.[0]}
            index={i}
          />
        </li>
      ))}
    </ul>
  </div>
</section>
