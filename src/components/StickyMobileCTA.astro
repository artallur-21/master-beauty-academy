---
import { SITE } from '@lib/site';
---
<div class="lg:hidden fixed bottom-0 inset-x-0 z-40 grid grid-cols-2 border-t border-ink-200 bg-white/95 backdrop-blur">
  <a href={`tel:${SITE.phonePrimary}`} class="flex items-center justify-center gap-2 py-3.5 font-medium text-brand-700">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.86 19.86 0 0 1 2.08 4.18 2 2 0 0 1 4.07 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.72 2.8a2 2 0 0 1-.45 2.11L8 9.91a16 16 0 0 0 6.09 6.09l1.28-1.28a2 2 0 0 1 2.11-.45c.9.36 1.84.59 2.8.72a2 2 0 0 1 1.72 2.03Z"/></svg>
    Call Now
  </a>
  <a href={`https://wa.me/${SITE.phoneWhatsapp}?text=${encodeURIComponent(SITE.whatsappMessage)}`} rel="noopener" class="flex items-center justify-center gap-2 py-3.5 font-medium text-white bg-[#25D366]">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.52 3.48A11.78 11.78 0 0 0 12.04 0C5.46 0 .1 5.36.1 11.94c0 2.1.55 4.16 1.6 5.98L0 24l6.24-1.63a11.93 11.93 0 0 0 5.8 1.48c6.58 0 11.94-5.36 11.94-11.94 0-3.19-1.24-6.19-3.47-8.43Z"/></svg>
    WhatsApp
  </a>
</div>
