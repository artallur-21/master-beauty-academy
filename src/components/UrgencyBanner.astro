---
/**
 * Subtle urgency banner — "Last batch started [N days] ago · Next intake in [X] weeks".
 * Computes dates at build time. If both dates are stale, the banner doesn't render.
 */
interface Props {
  /** ISO date of the last batch's start */
  lastBatchStart?: string;
  /** ISO date of the next batch's start */
  nextBatchStart?: string;
  /** Spots remaining for the next batch (1–12) */
  spotsLeft?: number;
  city?: string;
}

const today = new Date();
const fourWeeksAgo = new Date(today); fourWeeksAgo.setDate(today.getDate() - 18);
const inThreeWeeks = new Date(today); inThreeWeeks.setDate(today.getDate() + 21);

const {
  lastBatchStart = fourWeeksAgo.toISOString().slice(0, 10),
  nextBatchStart = inThreeWeeks.toISOString().slice(0, 10),
  spotsLeft = 5,
  city,
} = Astro.props;

const daysSince = Math.max(0, Math.floor((today.getTime() - new Date(lastBatchStart).getTime()) / 86400000));
const daysUntil = Math.max(0, Math.floor((new Date(nextBatchStart).getTime() - today.getTime()) / 86400000));
const nextLabel = new Date(nextBatchStart).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
---

<aside class="bg-brand-900 text-ink-100 text-sm">
  <div class="container-w container-px py-2.5 flex flex-wrap items-center justify-center gap-x-6 gap-y-1.5 text-center">
    <span class="inline-flex items-center gap-2">
      <span aria-hidden="true" class="w-1.5 h-1.5 rounded-full bg-gold-400 animate-pulse"></span>
      <span><span class="text-gold-400 font-medium">Last batch</span> started {daysSince} days ago{city ? ` in ${city}` : ''}</span>
    </span>
    <span aria-hidden="true" class="opacity-30">·</span>
    <span><span class="text-gold-400 font-medium">Next intake:</span> {nextLabel}{daysUntil > 0 && ` (in ${daysUntil} days)`}</span>
    <span aria-hidden="true" class="opacity-30">·</span>
    <span><span class="text-gold-400 font-medium">{spotsLeft}</span> of 12 seats remaining</span>
    <a href="/contact" class="ml-2 underline underline-offset-4 decoration-gold-400 hover:text-white font-medium">Reserve seat →</a>
  </div>
</aside>
